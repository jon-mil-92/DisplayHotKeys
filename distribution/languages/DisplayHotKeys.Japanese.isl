; Display Hot Keys messages for the Japanese installer, read after the Inno Setup messages of that language

[Messages]
; Inno Setup's Japanese messages lack this entry, so it gets the same empty value as English to compile cleanly
HelpTextNote=

[CustomMessages]
; Language tag the app reads to show itself in the language picked for setup
AppLanguageTag=ja
RemoveSettingsPrompt=すべてのユーザーの保存された Display Hot Keys の設定も削除しますか？%n%n残しておくと、再インストール時に保存されたスロットが保持されます。
