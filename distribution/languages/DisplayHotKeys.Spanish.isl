; Display Hot Keys messages for the Spanish installer, read after the Inno Setup messages of that language

[CustomMessages]
; Language tag the app reads to show itself in the language picked for setup
AppLanguageTag=es
RemoveSettingsPrompt=¿Desea eliminar también la configuración guardada de Display Hot Keys para todos los usuarios?%n%nConservarla mantiene las ranuras guardadas si vuelve a instalar.
